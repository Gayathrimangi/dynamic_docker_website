# ========================================================
# Dockerized Full-Stack Auth Environment Configuration
# ========================================================

# Flask & JWT Security Secrets
SECRET_KEY=replace-with-a-random-32-byte-hex-string
JWT_SECRET_KEY=replace-with-a-random-32-byte-jwt-secret-string
JWT_EXPIRES_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123
POSTGRES_DB=auth_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache & Storage Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OTP & Registration Expiration & Rate Limits
REGISTRATION_TTL=300         # 5 minutes pending TTL in Redis
OTP_MAX_ATTEMPTS=5          # Max invalid attempts before session invalidation
OTP_COOLDOWN_SECONDS=60     # Cooldown period before allowing OTP resend
OTP_MAX_RESENDS=3           # Max resend requests allowed per registration

# SMTP Email Configuration (Gmail App Password or Standard SMTP)
# For Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to "App passwords": https://myaccount.google.com/apppasswords
# 3. Create an app named "AuthWebApp" and copy the 16-character password (e.g. "abcd efgh ijkl mnop")
# 4. Fill in SMTP_USER and SMTP_PASSWORD below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Development / Testing Mode
# Set SMTP_DEV_MODE=true to simulate OTP emails without requiring real SMTP credentials
SMTP_DEV_MODE=false
